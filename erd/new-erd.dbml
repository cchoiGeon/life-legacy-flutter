// ─────────────────────────────────────────────────────────────
// new-erd.dbml
// 변경 후 = 앱(PickDam) 전용 백엔드 신규 RDB 스키마
//
// 기준 문서
//   docs/api-spec.md      API 명세
//   docs/목차-케이스.md    케이스 8종 · 대주제 조건
//
// 대상 DBMS: PostgreSQL (uuid / jsonb / timestamptz 사용)
//   MySQL이면 uuid→CHAR(36) 또는 BINARY(16), jsonb→JSON,
//   timestamptz→DATETIME(6) + 앱 레벨 UTC 고정으로 치환한다.
//
// 1차 범위 제외: 사진 첨부, 관리자, 승인·결제·인쇄 발주,
//               인생 방향 케이스(direction_*)
// ─────────────────────────────────────────────────────────────

Enum chapter_status {
  locked  [note: '앞 장을 끝내야 열린다']
  writing [note: '작성 중. 사용자당 최대 1개']
  done    [note: '모든 질문 완료']
}

Enum question_status {
  pending  [note: '아직 답하지 않음']
  answered [note: '확정 저장됨']
  skipped  [note: '건너뜀. 자서전 본문에 실리지 않는다']
}

Enum input_mode {
  voice
  keyboard
}

Enum draft_phase {
  first    [note: '1차 답변 저장됨, 꼬리질문 생성 대기/완료']
  followup [note: '꼬리질문 제시됨, 꼬리답변 대기']
}

Enum polish_status {
  ok
  failed [note: '윤문 실패. 원문은 살아 있다']
}

Enum condition_axis {
  always
  college  [note: '학력이 대학교 이상일 때만']
  marriage [note: '결혼 O일 때만']
  children [note: '자녀 O일 때만']
}

Enum ai_task_kind {
  followup [note: '꼬리질문 생성']
  polish   [note: '작가체 윤문']
}

// ═══════════════════════════════════════════════════════════
// 1. 사용자 · 인증
// ═══════════════════════════════════════════════════════════

Table app_user {
  id uuid [pk, default: `gen_random_uuid()`]
  phone varchar(11) [unique, note: '숫자만 11자리. 카카오 전용 가입이면 null']
  name varchar(50) [not null, default: '', note: '자기소개 i1에서 채워진다. 가입 직후엔 빈 문자열']
  child_linked boolean [not null, default: false, note: '자녀 계정 연결. 흐름은 2차']
  intro_completed_at timestamptz [note: 'null이면 API의 needs_intro=true']
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: '탈퇴. soft delete로 두고 본문은 보존 기간 후 파기']

  indexes {
    phone [unique, name: 'ux_app_user_phone']
  }

  Note: '''
  전화번호 SMS 인증 또는 카카오로 로그인한다. 비밀번호가 없다.
  name은 표시 전용 비정규화 값이다 — 원본은 user_intro_answer에 있다.
  '''
}

Table social_account {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  provider varchar(20) [not null, note: 'kakao']
  provider_user_id varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_user_id) [unique, name: 'ux_social_provider_uid']
    user_id [name: 'ix_social_user']
  }
}

Table phone_verification {
  id uuid [pk, default: `gen_random_uuid()`]
  phone varchar(11) [not null]
  code_hash varchar(255) [not null, note: '평문 저장 금지']
  expires_at timestamptz [not null, note: 'API의 expires_in 계산 근거']
  resend_available_at timestamptz [not null, note: 'API의 resend_after 계산 근거']
  attempt_count smallint [not null, default: 0, note: '5회 초과 시 폐기']
  consumed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (phone, created_at) [name: 'ix_phone_verification_lookup']
  }

  Note: '만료 건은 배치로 삭제한다.'
}

Table refresh_token {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null, note: '60일']
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'ix_refresh_token_user']
  }

  Note: '갱신 시 회전(rotation). 이전 토큰은 revoked_at을 찍는다.'
}

Table device_push_token {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  platform varchar(10) [not null, note: 'ios | android']
  token varchar(255) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '"오늘의 질문 알림" 발송 대상.'
}

// ═══════════════════════════════════════════════════════════
// 2. 자기소개 · 케이스 판정
// ═══════════════════════════════════════════════════════════

Table intro_question {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(10) [not null, unique, note: 'i1 ~ i5. API의 question_id']
  sort_order smallint [not null]
  text varchar(200) [not null, note: '\\n이 줄바꿈 위치다']
  subtitle varchar(200)
  hint varchar(100) [note: 'choices가 없을 때만 쓰는 placeholder']
  axis condition_axis [not null, default: 'always', note: '이 문항이 가르는 축. i3=marriage, i4=children, i5=college, i1·i2=always(케이스와 무관)']
  is_active boolean [not null, default: true]

  Note: '5문항 고정. 문항 추가 시 이 표에 줄만 늘린다.'
}

Table intro_choice {
  id uuid [pk, default: `gen_random_uuid()`]
  intro_question_id uuid [not null]
  sort_order smallint [not null]
  label varchar(50) [not null, note: '화면에 뜨는 글자. "대학교 이상"']
  axis_value boolean [note: '이 선택지가 축을 켜는가. i5의 "대학교 이상"만 true, 나머지 3개는 false. axis=always면 null']

  indexes {
    (intro_question_id, sort_order) [unique, name: 'ux_intro_choice_order']
  }

  Note: '''
  선택지를 표로 두는 이유 — 학력 4지선다의 원본 값을 그대로 보존하면서
  "대학 O/X" 판정을 axis_value 한 칸으로 파생시키기 위해서다.
  나중에 "고등학교 졸업"과 "중학교 졸업"을 나눠 질문을 주고 싶어지면
  user_intro_answer에 원본이 남아 있으므로 데이터가 있다.
  '''
}

Table user_intro_answer {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  intro_question_id uuid [not null]
  intro_choice_id uuid [note: '선택지 문항일 때. 텍스트 문항이면 null']
  value_text varchar(200) [not null, note: '사용자가 고르거나 적은 원본 문자열. 판정용으로 접지 않는다']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, intro_question_id) [unique, name: 'ux_user_intro_answer']
  }
}

Table case_definition {
  id uuid [pk, default: `gen_random_uuid()`]
  case_key varchar(60) [not null, unique, note: 'legacy_college_married_children 등 8종']
  title varchar(100) [not null]
  description varchar(300) [not null]
  has_college boolean [not null]
  has_marriage boolean [not null]
  has_children boolean [not null]
  sort_order smallint [not null]

  indexes {
    (has_college, has_marriage, has_children) [unique, name: 'ux_case_axes']
  }

  Note: '''
  8종 = 2(대학) x 2(결혼) x 2(자녀). 세 축이 서로 독립이다.
  축 조합에 unique를 걸어 중복·누락 케이스가 들어오지 못하게 한다.
  케이스별 목차 목록을 이 표에 나열하지 않는다 — chapter_template.condition에서 파생된다.
  '''
}

Table user_profile {
  user_id uuid [pk]
  case_id uuid [not null]
  display_name varchar(50) [not null, note: '책 표지에 들어갈 이름']
  gender varchar(10) [note: '문체 호칭용. 케이스와 무관']
  education_level varchar(30) [not null, note: 'i5 원본 값. "고등학교" 등']
  has_college boolean [not null]
  has_marriage boolean [not null]
  has_children boolean [not null]
  toc_confirmed_at timestamptz [note: 'null이면 목차 확정 전']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  자기소개에서 파생된 판정 결과. 원본은 user_intro_answer에 그대로 있다.
  has_* 세 개를 여기 복사해 두는 이유는 케이스 정의가 나중에 바뀌어도
  이미 목차를 확정한 사용자가 흔들리지 않게 하기 위해서다.
  '''
}

// ═══════════════════════════════════════════════════════════
// 3. 목차 · 질문 카탈로그 (전 사용자 공용, 시드 데이터)
// ═══════════════════════════════════════════════════════════

Table chapter_template {
  id uuid [pk, default: `gen_random_uuid()`]
  code smallint [not null, unique, note: '1~10. 문서의 대주제 번호']
  title varchar(100) [not null]
  sort_order smallint [not null, note: '목차에 놓이는 순서']
  condition condition_axis [not null, default: 'always']
  is_active boolean [not null, default: true]

  Note: '''
  대주제 10개. 이 중 3개만 조건부다 —
    code 4  20대 시절-대학생활  condition=college
    code 6  결혼 이야기         condition=marriage
    code 7  자녀 이야기         condition=children
  나머지 7개는 always(36문항).

  케이스별 목차를 따로 저장하지 않는 이유: 대주제를 하나 추가할 때
  8개 케이스를 모두 손대야 하는 구조를 피하려는 것이다.
  목차 = chapter_template 중 condition을 사용자 축이 만족하는 것들.
  '''
}

Table question_template {
  id uuid [pk, default: `gen_random_uuid()`]
  chapter_template_id uuid [not null]
  sort_order smallint [not null]
  text varchar(500) [not null]
  is_active boolean [not null, default: true]

  indexes {
    (chapter_template_id, sort_order) [unique, name: 'ux_question_template_order']
  }

  Note: '''
  총 52문항(대주제별 5~6개). 케이스별로 문구가 달라지지 않으므로
  케이스 축으로 복제하지 않는다.
  '''
}

// ═══════════════════════════════════════════════════════════
// 4. 사용자별 스냅샷
//    목차 확정 시점에 카탈로그를 복제한다.
//    이유 (1) 질문 문구 수정이 다른 사용자에게 번지면 안 된다
//         (2) 카탈로그가 바뀌어도 쓰기 시작한 자서전은 흔들리면 안 된다
// ═══════════════════════════════════════════════════════════

Table user_chapter {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  chapter_template_id uuid [note: '출처. 카탈로그에서 지워져도 남게 nullable']
  sort_order smallint [not null, note: '1부터. "제1장"의 숫자. 사용자가 순서를 바꾸면 다시 매긴다']
  title varchar(100) [not null, note: '복제 시점의 제목']
  status chapter_status [not null, default: 'locked']
  question_count smallint [not null, default: 0, note: '캐시. user_question 개수']
  answered_count smallint [not null, default: 0, note: '캐시. answered + skipped 개수']
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, sort_order) [unique, name: 'ux_user_chapter_order']
    (user_id, status) [name: 'ix_user_chapter_status']
  }

  Note: '''
  장 순차 잠금 —
    목차 확정 시 sort_order=1만 writing, 나머지 locked.
    한 장이 done이 되면 다음 장 하나만 writing으로 연다.
    writing은 사용자당 최대 1개다(앱이 이 가정 위에 서 있다).
    DB 제약으로 강제하려면 부분 유니크 인덱스를 건다:
      CREATE UNIQUE INDEX ux_user_chapter_writing
        ON user_chapter(user_id) WHERE status = 'writing';
  '''
}

Table user_question {
  id uuid [pk, default: `gen_random_uuid()`]
  user_chapter_id uuid [not null]
  question_template_id uuid [note: '출처']
  sort_order smallint [not null, note: '장 안에서의 순번. "질문 3 / 6"의 앞 숫자']
  text varchar(500) [not null, note: '복제 시점의 문구. 사용자가 고칠 수 있다']
  is_edited boolean [not null, default: false, note: '문구를 고쳤는지']
  status question_status [not null, default: 'pending']
  answered_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_chapter_id, sort_order) [unique, name: 'ux_user_question_order']
    (user_chapter_id, status) [name: 'ix_user_question_status']
  }

  Note: '''
  문구 수정은 status=pending일 때만 허용한다 —
  이미 답한 질문의 문구를 바꾸면 저장된 원고와 어긋난다(API 409 ALREADY_ANSWERED).
  '''
}

// ═══════════════════════════════════════════════════════════
// 5. 답변
//    질문 1개 = 묶음 1개
//    (원질문, 1차 답변, 꼬리질문, 꼬리답변, 윤문 결과)
// ═══════════════════════════════════════════════════════════

Table answer {
  id uuid [pk, default: `gen_random_uuid()`]
  user_question_id uuid [not null, unique, note: '질문당 1행. 1:1']
  question_text varchar(500) [not null, note: '답변 당시의 질문 문구 스냅샷']
  first_text text [not null, note: '사용자 원문. 음성이면 받아쓴 결과 그대로']
  first_input_mode input_mode [not null]
  first_spoken_seconds smallint [note: 'voice일 때 말한 시간']
  polished_text text [note: 'AI 작가체 윤문 결과. 사용자에게 작성 화면에서는 보여주지 않는다']
  polish_status polish_status [not null, default: 'ok']
  polish_attempts smallint [not null, default: 0]
  answered_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  사용자에게 보이는 것은 first_text(와 꼬리답변)뿐이다.
  polished_text가 처음 눈에 띄는 곳은 자서전 미리보기(book_page)다.
  건너뛴 질문은 이 행을 만들지 않는다 — user_question.status=skipped로만 남는다.
  '''
}

Table answer_followup {
  id uuid [pk, default: `gen_random_uuid()`]
  answer_id uuid [not null]
  seq smallint [not null, default: 1, note: 'v1은 항상 1']
  question_text text [not null, note: 'AI가 만든 꼬리질문. 요약+공감+질문 한 덩어리']
  answer_text text [not null, note: '사용자 원문']
  input_mode input_mode [not null]
  spoken_seconds smallint
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (answer_id, seq) [unique, name: 'ux_answer_followup_seq']
  }

  Note: '''
  v1 사양은 질문당 꼬리질문 정확히 1회다. 그래도 별도 표로 두는 이유 —
  answer에 followup_question/followup_answer 컬럼을 박으면 2회로 늘릴 때
  마이그레이션이 필요하지만, seq만 늘리면 스키마가 그대로다.
  운영 중인 웹은 이미 N회를 쓰고 있어 늘어날 여지가 실재한다.
  '''
}

Table answer_draft {
  id uuid [pk, default: `gen_random_uuid()`]
  user_question_id uuid [not null, unique]
  phase draft_phase [not null, default: 'first']
  first_text text [not null]
  first_input_mode input_mode [not null]
  first_spoken_seconds smallint
  followup_question_text text [note: 'AI가 만든 꼬리질문. phase=followup부터 채워진다']
  followup_id uuid [note: 'API 경로의 followup_id. 앱이 되돌려 보낸다']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  확정 전 임시 저장. 확정되면 삭제한다.

  실패 처리가 두 갈래다 —
    꼬리질문 생성 실패(422 FOLLOWUP_FAILED)
      → 이 행을 삭제한다. 사용자는 질문부터 다시 답한다.
        (사용자가 아직 한 번밖에 답하지 않은 시점이라 감수한다)
    윤문 실패(422 POLISH_FAILED)
      → 이 행을 남긴다. 앱은 저장 실패 화면에서 글을 보여준 채
        같은 요청을 재전송하고, 서버는 멱등하게 처리한다.
        (두 번 답한 이야기를 날리지 않는다)
  '''
}

// ═══════════════════════════════════════════════════════════
// 6. 자서전 결과물
// ═══════════════════════════════════════════════════════════

Table book {
  user_id uuid [pk]
  title varchar(100) [not null, default: '나의 이야기']
  author_name varchar(50) [not null]
  page_count integer [not null, default: 0]
  photo_count integer [not null, default: 0, note: 'v1은 항상 0. 사진 첨부는 2차']
  is_complete boolean [not null, default: false, note: '모든 장이 done']
  generated_at timestamptz [note: '마지막으로 쪽을 다시 나눈 시각']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'chapter_count / question_count는 user_chapter에서 집계한다 — 여기 복사하지 않는다.'
}

Table book_page {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  user_chapter_id uuid [not null]
  page_number integer [not null, note: '책 전체 통쪽수. 장마다 1로 돌아가지 않는다']
  paragraphs jsonb [not null, note: 'string[]. 문단 단위']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, page_number) [unique, name: 'ux_book_page_number']
    user_chapter_id [name: 'ix_book_page_chapter']
  }

  Note: '''
  done 장의 polished_text를 이어 붙여 서버가 쪽을 나눈 결과.
  장이 완료될 때마다 그 장의 쪽을 다시 만든다(기존 행 삭제 후 재삽입).
  앱은 받은 대로 그리기만 한다.
  '''
}

// ═══════════════════════════════════════════════════════════
// 7. 알림 · 설정
// ═══════════════════════════════════════════════════════════

Table notification {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  type varchar(30) [not null, note: 'daily_question | chapter_done | book_ready']
  title varchar(200) [not null, note: '"오늘의 질문이 도착했어요 · 학창 시절과 꿈"']
  link_user_question_id uuid [note: '눌렀을 때 갈 질문']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'ix_notification_user_recent']
  }

  Note: '''
  API의 time_label("오늘 오전 9:00")은 created_at을 서버가 포맷한 값이다.
  기기 시계가 틀어지면 상대 시각이 엉뚱해지므로 앱에서 계산하지 않는다.
  '''
}

Table user_setting {
  user_id uuid [pk]
  daily_question_alarm boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'v1에서 켜고 끌 수 있는 건 이 하나뿐이다.'
}

Table shipping_address {
  user_id uuid [pk]
  recipient varchar(50) [not null, default: '']
  phone varchar(11) [not null, default: '', note: '숫자만. 띄우는 건 표시할 때만']
  postal_code varchar(10) [not null, default: '']
  line1 varchar(200) [not null, default: '', note: '기본 주소']
  line2 varchar(200) [not null, default: '', note: '상세 주소. 비어도 된다']
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  등록 전에도 행을 만들어 빈 문자열로 둔다 — API가 404 대신 빈 객체를
  돌려주기로 했고, 앱이 "없음"과 "못 불러옴"을 구분할 필요가 없다.
  '''
}

// ═══════════════════════════════════════════════════════════
// 8. AI 운영
// ═══════════════════════════════════════════════════════════

Table prompt_template {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(30) [not null, unique, note: 'followup | polish']
  title varchar(100) [not null]
  body text [not null, note: '{{chapter_title}} {{question}} {{answer}} 같은 플레이스홀더']
  version integer [not null, default: 1]
  updated_by varchar(100)
  updated_at timestamptz [not null, default: `now()`]

  Note: '프롬프트를 코드에 박지 않는다. 문구 조정이 배포 없이 되어야 한다.'
}

Table ai_generation_log {
  id uuid [pk, default: `gen_random_uuid()`]
  user_question_id uuid [not null]
  kind ai_task_kind [not null]
  model varchar(60) [not null]
  prompt_template_version integer
  attempt smallint [not null, default: 1]
  succeeded boolean [not null]
  error_code varchar(60)
  input_tokens integer
  output_tokens integer
  latency_ms integer
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_question_id, kind) [name: 'ix_ai_log_question']
    (created_at) [name: 'ix_ai_log_time']
  }

  Note: '''
  실패 두 종(FOLLOWUP_FAILED / POLISH_FAILED)이 얼마나 자주 나는지가
  이 서비스의 체감 품질을 좌우한다. 재시도 횟수와 원인을 남긴다.
  본문(프롬프트·응답)은 남기지 않는다 — 민감 개인정보다.
  '''
}

// ═══════════════════════════════════════════════════════════
// 관계
// ═══════════════════════════════════════════════════════════

// 사용자 · 인증
Ref: social_account.user_id > app_user.id [delete: cascade]
Ref: refresh_token.user_id > app_user.id [delete: cascade]
Ref: device_push_token.user_id > app_user.id [delete: cascade]

// 자기소개 · 케이스
Ref: intro_choice.intro_question_id > intro_question.id [delete: cascade]
Ref: user_intro_answer.user_id > app_user.id [delete: cascade]
Ref: user_intro_answer.intro_question_id > intro_question.id [delete: restrict]
Ref: user_intro_answer.intro_choice_id > intro_choice.id [delete: set null]
Ref: user_profile.user_id - app_user.id [delete: cascade]
Ref: user_profile.case_id > case_definition.id [delete: restrict]

// 카탈로그
Ref: question_template.chapter_template_id > chapter_template.id [delete: cascade]

// 사용자 스냅샷
Ref: user_chapter.user_id > app_user.id [delete: cascade]
Ref: user_chapter.chapter_template_id > chapter_template.id [delete: set null]
Ref: user_question.user_chapter_id > user_chapter.id [delete: cascade]
Ref: user_question.question_template_id > question_template.id [delete: set null]

// 답변
Ref: answer.user_question_id - user_question.id [delete: cascade]
Ref: answer_followup.answer_id > answer.id [delete: cascade]
Ref: answer_draft.user_question_id - user_question.id [delete: cascade]

// 자서전
Ref: book.user_id - app_user.id [delete: cascade]
Ref: book_page.user_id > app_user.id [delete: cascade]
Ref: book_page.user_chapter_id > user_chapter.id [delete: cascade]

// 알림 · 설정
Ref: notification.user_id > app_user.id [delete: cascade]
Ref: notification.link_user_question_id > user_question.id [delete: set null]
Ref: user_setting.user_id - app_user.id [delete: cascade]
Ref: shipping_address.user_id - app_user.id [delete: cascade]

// AI
Ref: ai_generation_log.user_question_id > user_question.id [delete: cascade]

// ─────────────────────────────────────────────────────────────
// previous 대비 달라진 점
//
// 1. 케이스별 목차·질문 복제 테이블(case_content / case_question)을 없앴다.
//    목차는 chapter_template.condition과 user_profile.has_*의 조합으로
//    파생된다. 대주제를 하나 추가해도 고칠 곳이 한 곳이다.
//
// 2. 모든 관계를 FK로 묶었다. 웹은 (userId, content_id, question_id,
//    case_name) 4컬럼 조합으로 이어져 있어 참조 무결성이 없었다.
//
// 3. 답변의 네 조각을 각자 칸에 넣었다.
//    원문 answer.first_text / 꼬리 answer_followup / 윤문 answer.polished_text.
//    json 덩어리에서 꺼내지 않아도 된다.
//
// 4. user_chapter.status로 장 순차 잠금을 표현한다. 웹에는 없던 개념이다.
//
// 5. 인증을 전화번호 SMS + 카카오로 갈아 끼웠다.
//    (NextAuth의 user/account/session/verification_token 4종 제거)
//
// 6. 자기소개를 자유 텍스트 한 덩어리(profile.data)에서 문항별 행
//    (user_intro_answer)으로 바꿨다. 학력 원본 값이 남는다.
//
// 7. 앱 1차 범위 밖이라 뺀 것 — answer_attachment, photo_inbox,
//    manuscript_edit_history, approval_request, user_style_memory,
//    app_setting, outline, 관리자 계열.
// ─────────────────────────────────────────────────────────────
